    "clean": "rm -rf dist",
    "test": "pnpm -w exec vitest run --root packages/plugins/create-pilot-plugin --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pilotai/plugin-sdk": "workspace:*"
