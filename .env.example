DATABASE_URL=postgres://pilot:pilot@localhost:5432/pilot
PORT=3100
SERVE_UI=false
BETTER_AUTH_SECRET=pilot-dev-secret
PILOT_TOOL_ACTION_SIGNING_SECRET=pilot-dev-tool-action-signing-secret-change-me

# Keycloak SSO (board sign-in through the org's internal realm).
# Set ALL THREE to enable; the sign-in page then offers "Sign in with SSO".
# Issuer is the realm URL, e.g. https://login.patty.io/realms/internal
# PILOT_KEYCLOAK_ISSUER=https://login.patty.io/realms/internal
# PILOT_KEYCLOAK_CLIENT_ID=pilot-board
# PILOT_KEYCLOAK_CLIENT_SECRET=change-me
# Exact emails promoted to instance_admin on SSO sign-in
# PILOT_SSO_ADMIN_EMAILS=ceo@example.com
# Work-email domains whose users are auto-joined as plain members on SSO sign-in
# PILOT_SSO_DOMAINS=example.com

# Process-wide protection for expensive full-tree workspace Git scans.
# PILOT_WORKSPACE_GIT_SCAN_CONCURRENCY=2
# PILOT_WORKSPACE_GIT_SCAN_QUEUE_CAPACITY=32
# PILOT_WORKSPACE_GIT_SCAN_TIMEOUT_MS=8000
# PILOT_WORKSPACE_GIT_SCAN_CACHE_TTL_MS=10000

# Discord webhook for daily merge digest (scripts/discord-daily-digest.sh)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
